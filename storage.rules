rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Mirrors firestore.rules: everything lives under users/{uid}/... and only
    // that signed-in owner may read or write it (photos, audio — see
    // src/types/models.ts and the spec's data model section).
    match /users/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
