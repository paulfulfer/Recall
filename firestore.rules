rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Every document lives under users/{uid}/... (see src/types/models.ts) — only
    // the signed-in owner of that uid may read or write their own subtree.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
